# ─── Local infrastructure (infrastructure/docker/compose.yml) ────────────────
# Postgres (one logical DB per service); host port 5433 to avoid
# clashing with any locally running postgres
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme_dev_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis (SSE fan-out, search cache)
REDIS_URL=redis://localhost:6379

# Kafka (KRaft, single broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ElasticSearch (song catalog)
ELASTICSEARCH_URL=http://localhost:9200

# MinIO (S3-compatible media storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MOVIE_MEDIA=movie-media
S3_BUCKET_SONG_MEDIA=song-media

# Mailpit (email capture); web UI + API on 8025, SMTP on 1026
MAILPIT_API_URL=http://localhost:8025/api/v1

# ─── Service runtime ─────────────────────────────────────────────────────────
# RS256 signing keys (dev fixtures; see infrastructure/docker/keys/README.md)
JWT_PRIVATE_KEY_FILE=infrastructure/docker/keys/dev-auth-private.pem
JWT_PUBLIC_KEY_FILE=infrastructure/docker/keys/dev-auth-public.pem
JWT_EXPIRY_SECS=900
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false

# Gateway entry point (Kong proxy)
GATEWAY_URL=http://localhost:8080

# Frontend dev server
FRONTEND_URL=http://localhost:5173

# ─── Notes ───────────────────────────────────────────────────────────────────
# Copy to .env for local docker compose. Never commit real secrets.
# Each service also reads PORT defaults: auth=8101 movie=8102 song=8103
# search=8104 license=8105 notification=8106
